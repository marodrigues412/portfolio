---
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';

const stats = [
  { n: '3', l: 'cubos oficiais de crédito construídos do zero' },
  { n: '10+', l: 'acompanhamentos gerenciais reestruturados' },
  { n: '3', l: 'produtos de crédito sob meu MIS' },
  { n: '2026', l: 'TCC apresentado na Feira Eureka' },
];

const experiencias = [
  {
    periodo: 'mai/2026 a atual',
    cargo: 'Analista de BI Júnior',
    empresa: 'C6 Bank · Crédito & Analytics',
    itens: [
      'Responsável pelos processos de MIS de Cartão, Crédito Pessoal e Cheque Especial: diários de carteira e onboarding, one pages por produto, acompanhamento de mercado e de TPV.',
      'Desenvolvo projeções e estudos analíticos, como a análise de main bank dos clientes para apoiar estratégias de principalidade.',
      'Uso IA generativa e Python (pandas, Jupyter) em automação de rotinas, análise exploratória e geração de materiais.',
    ],
  },
  {
    periodo: 'mar/2025 a abr/2026',
    cargo: 'Estagiária de BI',
    empresa: 'C6 Bank · Crédito & Analytics',
    itens: [
      'Participei da criação, do zero, dos acompanhamentos de Cheque Especial e depois assumi a frente de forma autônoma.',
      '3 cubos oficiais em SQL/BigQuery e Power BI: carteira, utilização, saldo, inadimplência e rentabilidade, em visões de carteira e safra.',
      'Materiais consumidos por Políticas de Crédito, heads e diretoria, e apresentados à alta liderança.',
    ],
  },
  {
    periodo: 'ago/2024 a mar/2025',
    cargo: 'Estagiária de BI / Análise de Dados',
    empresa: 'Codako',
    itens: [
      'Reestruturei 10+ acompanhamentos gerenciais, reconstruindo as bases no Databricks (SQL e PySpark).',
      'Redesenhei os dashboards em Power BI: análises mais rápidas, confiáveis e intuitivas.',
    ],
  },
  {
    periodo: 'jul/2023 a jun/2024',
    cargo: 'Trainee, Consultora e Líder de Tecnologia',
    empresa: 'Mauá Júnior',
    itens: [
      'Líder de Tecnologia (jan a jun/2024): gestão do time de Tecnologia e acompanhamento dos projetos da área, atuando também no desenvolvimento das soluções.',
      'Consultora júnior (out/2023 a fev/2024): desenvolvimento de sites e planilhas para clientes reais e apoio ao time de Gestão de Pessoas.',
      'Trainee (jul a out/2023): imersão nas áreas da empresa júnior e no funcionamento do mercado.',
    ],
  },
];

const projetos = [
  {
    tag: 'TCC · 2026',
    nome: 'Ampara',
    desc: 'App de segurança para mulheres que percebe quando algo pode não estar bem e avisa as pessoas de confiança da usuária, sem que ela precise abrir o app. Apresentado na Feira Eureka 2026.',
    stack: ['Mobile', 'Sensores', 'Machine Learning'],
    link: 'https://ampara.info',
    linkLabel: 'ampara.info',
    destaque: true,
  },
  {
    tag: 'Projeto Integrador · 2025',
    nome: 'Monitoramento Automatizado de Obras',
    desc: 'Acompanhamento de obras de infraestrutura combinando visão computacional, modelagem BIM e análise digital.',
    stack: ['Visão computacional', 'BIM'],
  },
  {
    tag: 'Projeto · 2025',
    nome: 'AmiPet',
    desc: 'App mobile para adoção responsável de animais: perfis de pets, match com adotantes e aprovação por ONGs.',
    stack: ['Kotlin', 'TypeScript'],
  },
  {
    tag: 'Mauá Metrô Day · 2024',
    nome: 'Passe Fácil',
    desc: 'Atendimento remoto para o Metrô de São Paulo, apresentado no Mauá Metrô Day.',
    stack: ['React Native', 'Firebase'],
  },
];

const stack = [
  { grupo: 'Dados & BI', itens: ['SQL', 'Google BigQuery', 'Databricks', 'PySpark', 'Power BI', 'DAX', 'Power Query', 'Excel avançado'] },
  { grupo: 'Análise', itens: ['KPIs', 'Carteira & safra', 'Projeções', 'Análise exploratória', 'Data viz'] },
  { grupo: 'Código & IA', itens: ['Python', 'pandas', 'Jupyter', 'IA generativa', 'AWS', 'TypeScript', 'React', 'Git'] },
];
---

<!doctype html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Maria Eduarda Rodrigues · Analista de BI</title>
    <meta name="description" content="Maria Eduarda Rodrigues, Analista de BI em Crédito & Analytics. SQL, BigQuery, Power BI, Python e Databricks." />
    <meta property="og:title" content="Maria Eduarda Rodrigues · Analista de BI" />
    <meta property="og:description" content="Do SELECT à decisão. Dados aplicados a negócio." />
    <meta property="og:image" content="/foto.jpg" />
    <meta name="theme-color" content="#F8F4F1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>

  <body>
    <header class="nav">
      <a href="#topo" class="mono-logo" aria-label="Início">MR<span>.</span></a>
      <nav>
        <a href="#experiencia">Experiência</a>
        <a href="#projetos">Projetos</a>
        <a href="#sobre">Sobre</a>
        <a href="#contato">Contato</a>
      </nav>
      <a href="/curriculo.pdf" target="_blank" class="nav-cv">Currículo ↗</a>
    </header>

    <main id="topo">
      <!-- HERO -->
      <section class="hero wrap">
        <div class="hero-text">
          <p class="eyebrow reveal"><span class="kw">--</span> analista de bi · crédito &amp; analytics</p>
          <h1 class="reveal">Maria Eduarda<br /><em>Rodrigues</em></h1>
          <p class="tagline reveal">Do <em>SELECT</em> à decisão.</p>
          <p class="lead reveal">
            Construo bases, dashboards e análises que transformam dados de crédito em decisão de negócio.
            Hoje no C6 Bank, com SQL, BigQuery, Power BI e Python.
          </p>
          <div class="ctas reveal">
            <a class="btn primary" href="/curriculo.pdf" target="_blank">Ver currículo</a>
            <a class="btn" href="/resume-en.pdf" target="_blank">Resume (EN)</a>
            <a class="btn ghost" href="https://www.linkedin.com/in/marodrigu3s/" target="_blank" rel="noopener">LinkedIn ↗</a>
          </div>
        </div>

        <div class="hero-photo reveal">
          <div class="arch">
            <img src="/foto.webp" alt="Foto de Maria Eduarda Rodrigues" width="800" height="800" />
          </div>
          <div class="chip chip-code">
            <span class="kw">SELECT</span> insight<br /><span class="kw">FROM</span> dados<br /><span class="kw">WHERE</span> impacto &gt; 0
          </div>
          <div class="chip chip-loc"><span class="dot"></span> São Paulo · C6 Bank</div>
        </div>
      </section>

      <!-- STATS -->
      <section class="stats wrap">
        {stats.map((s) => (
          <div class="stat reveal">
            <span class="stat-n">{s.n}</span>
            <span class="stat-l">{s.l}</span>
          </div>
        ))}
      </section>

      <!-- EXPERIÊNCIA -->
      <section id="experiencia" class="section wrap">
        <div class="section-head reveal">
          <p class="eyebrow"><span class="kw">01</span> / experiência</p>
          <h2>Trajetória</h2>
        </div>
        <ol class="timeline">
          {experiencias.map((e) => (
            <li class="exp reveal">
              <div class="exp-when">{e.periodo}</div>
              <div class="exp-body">
                <h3>{e.cargo}</h3>
                <p class="exp-org">{e.empresa}</p>
                <ul>
                  {e.itens.map((i) => <li>{i}</li>)}
                </ul>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <!-- PROJETOS -->
      <section id="projetos" class="section wrap">
        <div class="section-head reveal">
          <p class="eyebrow"><span class="kw">02</span> / projetos</p>
          <h2>Coisas que construí</h2>
        </div>
        <div class="grid">
          {projetos.map((p) => (
            <article class={`card reveal ${p.destaque ? 'featured' : ''}`}>
              <p class="card-tag">{p.tag}</p>
              <h3>{p.nome}</h3>
              <p class="card-desc">{p.desc}</p>
              <div class="pills">
                {p.stack.map((s) => <span class="pill">{s}</span>)}
              </div>
              {p.link && (
                <a class="card-link" href={p.link} target="_blank" rel="noopener">{p.linkLabel} ↗</a>
              )}
            </article>
          ))}
        </div>
      </section>

      <!-- STACK -->
      <section class="section wrap">
        <div class="section-head reveal">
          <p class="eyebrow"><span class="kw">03</span> / ferramentas</p>
          <h2>Stack</h2>
        </div>
        <div class="stack">
          {stack.map((g) => (
            <div class="stack-group reveal">
              <h4>{g.grupo}</h4>
              <div class="pills">
                {g.itens.map((i) => <span class="pill">{i}</span>)}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- SOBRE -->
      <section id="sobre" class="about">
        <div class="wrap about-inner">
          <p class="eyebrow light reveal"><span class="kw">04</span> / sobre</p>
          <p class="about-quote reveal">
            Gosto de entender o que está <em>por trás dos números</em> e transformar isso em algo que alguém consegue usar para decidir.
          </p>
          <div class="about-cols reveal">
            <p>
              Sou analista de BI no time de Crédito &amp; Analytics do C6 Bank e estudante de Ciência da Computação
              no Instituto Mauá de Tecnologia (conclusão em dez/2026). Comecei como estagiária ajudando a construir os
              acompanhamentos de Cheque Especial do zero e hoje cuido do MIS de três produtos de crédito.
            </p>
            <p>
              Fora do banco, co-criei o Ampara, um app de segurança para mulheres, fui líder de tecnologia na Mauá Júnior,
              representante de turma e monitora. Quero seguir em posições que conectem dados, produto e estratégia.
            </p>
          </div>
        </div>
      </section>

      <!-- CONTATO -->
      <section id="contato" class="contact wrap">
        <p class="eyebrow reveal"><span class="kw">05</span> / contato</p>
        <h2 class="reveal">Vamos <em>conversar?</em></h2>
        <a class="mail reveal" href="mailto:marodriguess412@gmail.com">marodriguess412@gmail.com</a>
        <div class="contact-links reveal">
          <a href="https://www.linkedin.com/in/marodrigu3s/" target="_blank" rel="noopener">LinkedIn ↗</a>
          <a href="https://github.com/marodrigues412" target="_blank" rel="noopener">GitHub ↗</a>
          <a href="/curriculo.pdf" target="_blank">Currículo (PT) ↗</a>
          <a href="/resume-en.pdf" target="_blank">Resume (EN) ↗</a>
        </div>
      </section>
    </main>

    <footer class="wrap">
      <span>© 2026 Maria Eduarda Rodrigues</span>
      <small>
        Ícone por
        <a href="https://br.vexels.com/png-svg/previsualizar/355364/design-fofo-de-estrela-rosa" target="_blank" rel="noopener noreferrer">Vexels</a>
      </small>
    </footer>

    <script>
      const els = document.querySelectorAll('.reveal');
      if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) {
        els.forEach((el) => el.classList.add('in'));
      } else {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
          });
        }, { threshold: 0.12 });
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --paper: #F8F4F1;
    --paper-2: #F1EAE5;
    --ink: #2D2B33;
    --muted: #6E7180;
    --line: #E9DFE1;
    --navy: #273963;
    --navy-deep: #1D2C50;
    --rose: #BD5574;
    --rose-dark: #A84264;
    --pink: #F7E7EC;
    --serif: 'Instrument Serif', 'Iowan Old Style', Georgia, serif;
    --sans: 'Inter', -apple-system, 'Helvetica Neue', Arial, sans-serif;
    --mono: 'JetBrains Mono', Menlo, monospace;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 16px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  a { color: inherit; }
  em { font-style: italic; color: var(--rose-dark); }
  .wrap { width: min(1160px, 100% - 48px); margin-inline: auto; }
  .kw { color: var(--navy); font-weight: 500; }

  /* NAV */
  .nav {
    position: sticky; top: 0; z-index: 10;
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
    padding: 18px max(24px, calc((100% - 1160px) / 2));
    background: color-mix(in srgb, var(--paper) 82%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid transparent;
  }
  .mono-logo { font-family: var(--serif); font-size: 28px; text-decoration: none; line-height: 1; }
  .mono-logo span { color: var(--rose); }
  .nav nav { display: flex; gap: 28px; }
  .nav nav a, .nav-cv {
    font-family: var(--mono); font-size: 13px; text-decoration: none; color: var(--muted);
    transition: color .2s;
  }
  .nav nav a:hover { color: var(--ink); }
  .nav-cv {
    color: var(--ink); border: 1px solid var(--ink); padding: 8px 14px; border-radius: 999px;
  }
  .nav-cv:hover { background: var(--ink); color: var(--paper); }

  /* HERO */
  .hero {
    display: grid; grid-template-columns: 1.15fr .85fr; gap: 56px; align-items: center;
    padding: 72px 0 64px;
  }
  .eyebrow { font-family: var(--mono); font-size: 13px; color: var(--muted); margin: 0 0 18px; letter-spacing: .02em; }
  h1 {
    font-family: var(--serif); font-weight: 400;
    font-size: clamp(3.4rem, 8.2vw, 7.2rem); line-height: .92; letter-spacing: -.02em; margin: 0;
  }
  .tagline { font-family: var(--serif); font-size: clamp(1.6rem, 2.8vw, 2.3rem); margin: 28px 0 0; line-height: 1.1; }
  .lead { max-width: 520px; color: var(--muted); font-size: 1.05rem; margin: 18px 0 0; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .btn {
    font-family: var(--mono); font-size: 13px; text-decoration: none;
    padding: 13px 20px; border-radius: 999px; border: 1px solid var(--ink);
    transition: transform .2s, background .2s, color .2s;
  }
  .btn:hover { transform: translateY(-2px); }
  .btn.primary { background: var(--ink); color: var(--paper); }
  .btn.primary:hover { background: var(--rose-dark); border-color: var(--rose-dark); }
  .btn.ghost { border-color: transparent; text-decoration: underline; text-underline-offset: 4px; }

  .hero-photo { position: relative; justify-self: center; width: min(420px, 100%); }
  .arch {
    aspect-ratio: 4 / 5; border-radius: 999px 999px 28px 28px; overflow: hidden;
    background: var(--pink); box-shadow: 0 30px 60px -30px rgba(39, 57, 99, .35);
  }
  .arch img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; display: block; }
  .chip {
    position: absolute; background: #fff; border: 1px solid var(--line);
    box-shadow: 0 12px 30px -12px rgba(45, 43, 51, .25); border-radius: 14px;
    font-family: var(--mono); font-size: 12px; line-height: 1.6;
  }
  .chip-code { left: -44px; bottom: 64px; padding: 12px 16px; color: var(--muted); }
  .chip-loc { right: -18px; top: 40px; padding: 8px 14px; border-radius: 999px; color: var(--ink); display: flex; align-items: center; gap: 8px; }
  .chip-loc .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--rose); box-shadow: 0 0 0 4px var(--pink); }

  /* STATS */
  .stats {
    display: grid; grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
  }
  .stat { padding: 28px 24px 28px 0; display: flex; flex-direction: column; gap: 6px; }
  .stat + .stat { padding-left: 24px; border-left: 1px solid var(--line); }
  .stat-n { font-family: var(--serif); font-size: 3rem; line-height: 1; color: var(--navy); }
  .stat-l { font-size: .9rem; color: var(--muted); max-width: 200px; }

  /* SECTIONS */
  .section { padding: 112px 0 0; }
  .section-head { display: flex; align-items: baseline; justify-content: space-between; gap: 24px; margin-bottom: 40px; border-bottom: 1px solid var(--line); padding-bottom: 20px; }
  .section-head .eyebrow { margin: 0; order: 2; }
  h2 { font-family: var(--serif); font-weight: 400; font-size: clamp(2.4rem, 5vw, 3.8rem); line-height: 1; margin: 0; letter-spacing: -.01em; }

  /* TIMELINE */
  .timeline { list-style: none; margin: 0; padding: 0; }
  .exp {
    display: grid; grid-template-columns: 220px 1fr; gap: 32px;
    padding: 28px 0; border-bottom: 1px dashed var(--line);
  }
  .exp:first-child { padding-top: 0; }
  .exp-when { font-family: var(--mono); font-size: 13px; color: var(--rose-dark); padding-top: 6px; }
  .exp h3 { font-family: var(--serif); font-weight: 400; font-size: 1.9rem; margin: 0; line-height: 1.1; }
  .exp-org { margin: 4px 0 12px; color: var(--navy); font-weight: 500; font-size: .95rem; }
  .exp ul { margin: 0; padding-left: 18px; color: var(--muted); }
  .exp li + li { margin-top: 6px; }
  .exp li::marker { color: var(--rose); }

  /* PROJECTS */
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .card {
    background: #fff; border: 1px solid var(--line); border-radius: 22px; padding: 28px;
    display: flex; flex-direction: column; gap: 10px;
    transition: transform .25s, box-shadow .25s;
  }
  .card:hover { transform: translateY(-4px); box-shadow: 0 24px 40px -24px rgba(39, 57, 99, .3); }
  .card.featured {
    grid-column: span 3; background: var(--navy); color: #fff; border: none;
    padding: 40px; display: grid; grid-template-columns: 1fr 1fr; column-gap: 48px; align-items: end;
    position: relative; overflow: hidden;
  }
  .card.featured::after {
    content: ''; position: absolute; right: -80px; top: -80px; width: 280px; height: 280px; border-radius: 50%;
    background: radial-gradient(circle, rgba(189, 85, 116, .55), transparent 70%);
  }
  .card-tag { font-family: var(--mono); font-size: 12px; color: var(--muted); margin: 0; }
  .card h3 { font-family: var(--serif); font-weight: 400; font-size: 2rem; margin: 0; line-height: 1.05; }
  .card-desc { margin: 0; color: var(--muted); font-size: .95rem; }
  .featured .card-tag { color: #F7E7EC; grid-column: 1; }
  .featured h3 { font-size: clamp(3rem, 6vw, 4.6rem); grid-column: 1; grid-row: 2 / span 2; align-self: start; }
  .featured .card-desc { color: #D5DBEA; font-size: 1.05rem; grid-column: 2; grid-row: 1 / span 2; }
  .featured .pills { grid-column: 2; }
  .featured .card-link { grid-column: 2; color: #fff; }
  .pills { display: flex; flex-wrap: wrap; gap: 8px; margin-top: auto; padding-top: 6px; }
  .pill {
    font-family: var(--mono); font-size: 12px; padding: 5px 11px; border-radius: 999px;
    background: var(--paper); border: 1px solid var(--line); color: var(--ink);
  }
  .featured .pill { background: rgba(255, 255, 255, .08); border-color: rgba(255, 255, 255, .2); color: #fff; }
  .card-link { font-family: var(--mono); font-size: 13px; color: var(--rose-dark); }

  /* STACK */
  .stack { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  .stack h4 { font-family: var(--mono); font-weight: 500; font-size: 13px; color: var(--rose-dark); margin: 0 0 14px; text-transform: uppercase; letter-spacing: .08em; }
  .stack .pills { margin: 0; }

  /* ABOUT */
  .about { margin-top: 120px; background: var(--ink); color: #fff; padding: 112px 0; }
  .eyebrow.light { color: #A9ABB8; }
  .eyebrow.light .kw { color: #F7E7EC; }
  .about-quote {
    font-family: var(--serif); font-size: clamp(2rem, 4.2vw, 3.4rem); line-height: 1.1; margin: 0; max-width: 980px;
  }
  .about-quote em { color: #E79AB2; }
  .about-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; margin-top: 48px; color: #C9CAD3; }
  .about-cols p { margin: 0; }

  /* CONTACT */
  .contact { padding: 112px 0 80px; text-align: center; }
  .contact h2 { font-size: clamp(3rem, 8vw, 6.4rem); }
  .mail {
    display: inline-block; margin-top: 24px; font-family: var(--mono); font-size: clamp(1rem, 2.2vw, 1.3rem);
    text-decoration: none; border-bottom: 2px solid var(--rose); padding-bottom: 4px;
  }
  .mail:hover { color: var(--rose-dark); }
  .contact-links { display: flex; justify-content: center; flex-wrap: wrap; gap: 28px; margin-top: 36px; }
  .contact-links a { font-family: var(--mono); font-size: 13px; color: var(--muted); text-decoration: none; }
  .contact-links a:hover { color: var(--ink); }

  footer {
    display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap;
    border-top: 1px solid var(--line); padding: 24px 0 40px;
    font-family: var(--mono); font-size: 12px; color: var(--muted);
  }
  footer a { color: var(--rose-dark); }

  /* REVEAL */
  .reveal { opacity: 0; transform: translateY(16px); transition: opacity .7s ease, transform .7s ease; }
  .reveal.in { opacity: 1; transform: none; }

  /* RESPONSIVE */
  @media (max-width: 960px) {
    .hero { grid-template-columns: 1fr; gap: 48px; padding-top: 40px; }
    .hero-photo { order: -1; width: min(320px, 80%); }
    .chip-code { left: -24px; bottom: 40px; }
    .chip-loc { right: -12px; }
    .stats { grid-template-columns: repeat(2, 1fr); }
